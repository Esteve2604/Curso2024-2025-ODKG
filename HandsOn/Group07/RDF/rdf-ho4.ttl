<http://madrid.events.com/event/12543506> <http://schema.org/name> "¡ay Carmela!" .
<http://madrid.events.com/event/12543506> <http://schema.org/startDate> "2024-11-09T00:00:00Z" .
<http://madrid.events.com/event/12543506> <http://schema.org/url> "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=ca9671ee4a9eb410VgnVCM100000171f5a0aRCRD&vgnextoid=9e4d956aaac42910VgnVCM1000001d4a900aRCRD" .
