<http://madrid.events.com/installation/Centro%20Deportivo%20Municipal%20%C3%81ngel%20Nieto%20%28antiguo%20Puente%20de%20Vallecas%29> <http://schema.org/url> "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=fb1b42be9971c010VgnVCM1000000b205a0aRCRD" .
